rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net - default deny all (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive definitions & secure global helpers (Phase 3)
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints (Pillar 2 - Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.publicKey is string 
        && data.publicKey.size() > 0 
        && data.publicKey.size() <= 128
        && data.username is string 
        && data.username.size() > 0 
        && data.username.size() <= 100
        && data.tier is string 
        && data.tier.size() > 0 
        && data.tier.size() <= 50
        && data.access is string 
        && data.access.size() > 0 
        && data.access.size() <= 50
        // Optional fields (Pillar 6 - PII isolation validation)
        && (!('shippingName' in data) || (data.shippingName is string && data.shippingName.size() <= 200))
        && (!('shippingAddress' in data) || (data.shippingAddress is string && data.shippingAddress.size() <= 500))
        && (!('shippingCity' in data) || (data.shippingCity is string && data.shippingCity.size() <= 100))
        && (!('shippingZip' in data) || (data.shippingZip is string && data.shippingZip.size() <= 20));
    }

    function isValidScan(data) {
      return data.publicKey is string 
        && data.publicKey.size() > 0 
        && data.publicKey.size() <= 128
        && data.date is string 
        && data.date.size() > 0 
        && data.date.size() <= 50
        && data.location is string 
        && data.location.size() > 0 
        && data.location.size() <= 200
        && data.verdict is string 
        && data.verdict.size() > 0 
        && data.verdict.size() <= 50
        && data.matrix is string 
        && data.matrix.size() > 0 
        && data.matrix.size() <= 100
        && data.createdAt is string 
        && data.createdAt.size() > 0 
        && data.createdAt.size() <= 100
        && data.detections is list
        && data.detections.size() <= 100
        && (!('shortDescription' in data) || data.shortDescription == null || (data.shortDescription is string && data.shortDescription.size() <= 1000))
        && (!('longDescription' in data) || data.longDescription == null || (data.longDescription is string && data.longDescription.size() <= 10000));
    }

    // Route: users collection
    match /users/{publicKey} {
      // GET allowed for profile fetch. Private fields isolated via no-list rule (Pillar 6)
      allow get: if isValidId(publicKey);
      allow list: if false; // Blanket read query scraping forbidden

      // Create profile with exact structure validation
      allow create: if isValidId(publicKey) 
        && incoming().publicKey == publicKey
        && isValidUserProfile(incoming())
        && incoming().keys().hasAll(['publicKey', 'username', 'tier', 'access'])
        && incoming().keys().size() >= 4 
        && incoming().keys().size() <= 8;

      // Update profile under specific transition actions and affected key boundaries (Pillar 4)
      allow update: if isValidId(publicKey)
        && incoming().publicKey == existing().publicKey
        && isValidUserProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'tier', 'access', 'shippingName', 'shippingAddress', 'shippingCity', 'shippingZip']);

      // Profile deletion is prohibited
      allow delete: if false;
    }

    // Route: scans collection
    match /scans/{scanId} {
      // Scan logs can be read by clients (to show historical logs and landing ticker)
      allow get, list: if true;

      // Creating a new scan requires strict structure checks (Pillar 3/Pillar 5)
      allow create: if isValidId(scanId)
        && isValidScan(incoming())
        && incoming().keys().hasAll(['publicKey', 'date', 'location', 'verdict', 'matrix', 'detections', 'createdAt'])
        && incoming().keys().size() >= 7
        && incoming().keys().size() <= 9;

      // Scans are completely immutable once created (Anti-Tampering Guard)
      allow update, delete: if false;
    }
  }
}
